// WORLD_WAR_FREE_ROAM_V2: fictional energy blaster and repairable impact marks
let audioContext = null;
function playBlasterSound(){
 try {
  const AC = window.AudioContext || window.webkitAudioContext;
  if (!AC) return;

  if (!audioContext) audioContext = new AC();
  if (audioContext.state === "suspended") audioContext.resume();

  const now = audioContext.currentTime;

  // ضربه‌ی بم و کوتاه
  const low = audioContext.createOscillator();
  const lowGain = audioContext.createGain();

  low.type = "sine";
  low.frequency.setValueAtTime(115, now);
  low.frequency.exponentialRampToValueAtTime(68, now + 0.13);

  lowGain.gain.setValueAtTime(0.0001, now);
  lowGain.gain.linearRampToValueAtTime(0.045, now + 0.012);
  lowGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.17);

  low.connect(lowGain);
  lowGain.connect(audioContext.destination);
  low.start(now);
  low.stop(now + 0.18);

  // صدای الکترونیکی ظریف
  const high = audioContext.createOscillator();
  const highGain = audioContext.createGain();

  high.type = "triangle";
  high.frequency.setValueAtTime(430, now);
  high.frequency.exponentialRampToValueAtTime(190, now + 0.11);

  highGain.gain.setValueAtTime(0.0001, now);
  highGain.gain.linearRampToValueAtTime(0.018, now + 0.008);
  highGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.13);

  high.connect(highGain);
  highGain.connect(audioContext.destination);
  high.start(now);
  high.stop(now + 0.14);

 } catch(e) {
  console.warn("Blaster audio:", e);
 }
}
function addImpactMark(point, normal){
 const group = new THREE.Group();
 group.position.copy(point).addScaledVector(normal, .018);
 group.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1), normal.clone().normalize());
 const dark = new THREE.Mesh(
  new THREE.CircleGeometry(.105, 16),
  new THREE.MeshBasicMaterial({color:0x172b3c, transparent:true, opacity:.88, depthWrite:false})
 );
 group.add(dark);
 const rim = new THREE.Mesh(
  new THREE.TorusGeometry(.12,.018,6,24),
  new THREE.MeshBasicMaterial({color:0x28cfff, transparent:true, opacity:.9})
 );
 rim.position.z=.006; group.add(rim);
 const spark = new THREE.PointLight(0x16bfff, 1.1, 1.8);
 spark.position.z=.04; group.add(spark);
 scene.add(group);
 const born = performance.now();
 const fade = () => {
  if (!group.parent) return;
  const age=(performance.now()-born)/1000;
  if(age>=10){
   scene.remove(group);
   group.traverse(o=>{
    if(o.geometry) o.geometry.dispose();
    if(o.material) o.material.dispose();
   });
   return;
  }
  const opacity=age>8.5?Math.max(0,(10-age)/1.5):1;
  dark.material.opacity=.94*opacity;
  rim.material.opacity=.9*opacity;
  spark.intensity=opacity;
  requestAnimationFrame(fade);
 };
 requestAnimationFrame(fade);
}
