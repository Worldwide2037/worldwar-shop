    });

    // دست پشتی روی دسته
    box(.22,.18,.23,-.37,-.47,.10,glove);
    box(.18,.10,.22,-.37,-.55,.10,armor);
    box(.20,.09,.24,-.37,-.62,.10,black);

    // دست جلویی زیر لوله
    box(.30,.15,.24,.57,-.20,.10,glove);
    box(.23,.10,.25,.60,-.28,.10,armor);
    box(.22,.045,.26,.60,-.34,.10,black);

    // خطوط نور روی دستکش‌ها
    box(.15,.025,.025,-.37,-.50,.22,blue);
    box(.17,.025,.025,.60,-.25,.23,blue);

    return gun;
}
