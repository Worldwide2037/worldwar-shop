function update(dt){
 if(!running) return;

 // Fix firing cooldown
 fireCooldown=Math.max(0,fireCooldown-dt);

 const forward=(keys.w||keys.arrowup?1:0)+(keys.s||keys.arrowdown?-1:0)+joy.y;
 const side=(keys.d||keys.arrowright?1:0)+(keys.a||keys.arrowleft?-1:0)+joy.x;

 const move=new THREE.Vector2(side,forward);
 if(move.length()>1) move.normalize();

 // Smooth joystick movement
 const blend=Math.min(1,dt*12);
 smoothSide+=(move.x-smoothSide)*blend;
 smoothForward+=(move.y-smoothForward)*blend;

 const speed=(keys.shift?8:7.2)*dt;
 const dx=(smoothSide*Math.cos(player.yaw)-smoothForward*Math.sin(player.yaw))*speed;
 const dz=(smoothSide*Math.sin(player.yaw)+smoothForward*Math.cos(player.yaw))*speed;

 if(!blocked(player.pos.x+dx,player.pos.z)) player.pos.x+=dx;
 if(!blocked(player.pos.x,player.pos.z+dz)) player.pos.z+=dz;

 camera.position.copy(player.pos);
 camera.rotation.order="YXZ";
 camera.rotation.y=player.yaw;
 camera.rotation.x=player.pitch;

 // Switch between ship and Mars atmosphere
 const outsideMars = player.pos.z < -25.5;

 if(outsideMars !== marsMode){
  marsMode = outsideMars;

  if(marsMode){
   scene.background.set(0xb96b50);
   scene.fog = marsEnvironment.fog;
  } else {
   scene.background.set(0x101d30);
   scene.fog = shipFog;
  }
 }

 const moving=move.length()>.08;
 weapon.position.y=-Math.sin(performance.now()*.012)*(moving?.018:0);
 weapon.rotation.z=Math.sin(performance.now()*.009)*(moving?.012:0);
}

function animate(now){
 requestAnimationFrame(animate);
 const dt=Math.min((now-last)/1000,.04);last=now;update(dt);
 renderer.render(scene,camera);
}
requestAnimationFrame(animate);
addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
loading.style.display="none";
